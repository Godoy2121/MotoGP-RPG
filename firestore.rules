rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario puede leer y escribir su propio perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Personajes: el propietario puede leer/escribir
    match /characters/{charId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Temporadas: el propietario puede leer/escribir
    match /seasons/{seasonId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Leaderboard: cualquier usuario autenticado puede leer,
    // cada usuario solo puede escribir su propia entrada
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
